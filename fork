from pathlib import Path
from dataclasses import dataclass
from typing import List, Dict
import json


@dataclass
class RepositoryReport:
    name: str
    files: int
    directories: int
    languages: Dict[str, int]
    has_readme: bool
    has_gitignore: bool
    has_license: bool
    score: int


class RepositoryAnalyzer:
    """Analyze repository structure and calculate a quality score."""

    LANGUAGE_MAP = {
        ".py": "Python",
        ".js": "JavaScript",
        ".ts": "TypeScript",
        ".tsx": "TypeScript",
        ".jsx": "JavaScript",
        ".go": "Go",
        ".rs": "Rust",
        ".java": "Java",
        ".cpp": "C++",
        ".c": "C",
        ".cs": "C#",
        ".rb": "Ruby",
        ".php": "PHP",
        ".swift": "Swift",
        ".kt": "Kotlin",
    }

    def __init__(self, repository_path: str):
        self.root = Path(repository_path).resolve()

    def analyze(self) -> RepositoryReport:
        if not self.root.exists():
            raise FileNotFoundError(
                f"Repository not found: {self.root}"
            )

        files = [
            path for path in self.root.rglob("*")
            if path.is_file()
            and ".git" not in path.parts
        ]

        directories = [
            path for path in self.root.rglob("*")
            if path.is_dir()
            and ".git" not in path.parts
        ]

        languages = {}

        for file in files:
            language = self.LANGUAGE_MAP.get(file.suffix.lower())

            if language:
                languages[language] = languages.get(language, 0) + 1

        has_readme = (self.root / "README.md").exists()
        has_gitignore = (self.root / ".gitignore").exists()
        has_license = any(
            (self.root / name).exists()
            for name in ["LICENSE", "LICENSE.md", "LICENSE.txt"]
        )

        score = self._calculate_score(
            has_readme,
            has_gitignore,
            has_license,
            len(files)
        )

        return RepositoryReport(
            name=self.root.name,
            files=len(files),
            directories=len(directories),
            languages=languages,
            has_readme=has_readme,
            has_gitignore=has_gitignore,
            has_license=has_license,
            score=score,
        )

    @staticmethod
    def _calculate_score(
        has_readme: bool,
        has_gitignore: bool,
        has_license: bool,
        file_count: int
    ) -> int:

        score = 0

        if has_readme:
            score += 35

        if has_gitignore:
            score += 20

        if has_license:
            score += 20

        if file_count > 0:
            score += 15

        if file_count >= 5:
            score += 10

        return min(score, 100)


