@staticmethod
def run(repository_path: str):
    analyzer = RepositoryAnalyzer(repository_path)
    report = analyzer.analyze()

    output = {
        "repository": report.name,
        "files": report.files,
        "directories": report.directories,
        "languages": report.languages,
        "github_metadata": {
            "readme": report.has_readme,
            "gitignore": report.has_gitignore,
            "license": report.has_license,
        },
        "quality_score": report.score,
    }

    print(json.dumps(output, indent=4))

    return report

